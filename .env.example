# PostgreSQL (docker-compose)
DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io
# Compte applicatif limité (AUD-009). Les migrations créent le rôle de groupe `expense_app` ;
# créer un rôle LOGIN membre de ce groupe et l'utiliser comme DATABASE_URL du serveur applicatif.
# Les migrations, le seed et les scripts de préparation gardent un compte propriétaire des tables
# (par exemple en préfixant la commande : DATABASE_URL=<compte de préparation> npm run migrate:up).
# Avec le compte `expense` ci-dessus (superutilisateur), PostgreSQL n'applique pas la RLS.

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=changeme-generate-a-real-secret-for-non-local-use
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true
